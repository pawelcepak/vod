<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VOD"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Serial"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/seriesSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <TextView
            android:id="@+id/usbStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="14dp"
            android:text="Pendrive: nie wybrano"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/spaceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Wolne miejsce: —"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/downloadedSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Na pendrive: 0 odcinków"
            android:textSize="17sp" />

        <Button
            android:id="@+id/selectUsbButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="WYBIERZ PENDRIVE"
            android:textSize="17sp" />

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="Odśwież" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="16dp"
            android:background="#33000000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. WYBIERZ ODCINKI DO POBRANIA"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/episodesHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Najpierw podłącz i wybierz pendrive."
            android:textSize="16sp" />

        <TextView
            android:id="@+id/downloadSelectionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Zaznacz odcinki poniżej."
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/episodesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/showMoreEpisodesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="POKAŻ NASTĘPNE"
            android:visibility="gone" />

        <Button
            android:id="@+id/downloadButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="POBIERZ ZAZNACZONE NA PENDRIVE"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/downloadProgressTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pobieranie"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:enabled="false"
            android:text="Zatrzymaj pobieranie"
            android:visibility="gone" />

        <TextView
            android:id="@+id/currentDownloadText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="10dp"
            android:text="Brak aktywnego pobierania"
            android:textSize="17sp"
            android:textStyle="bold" 
            android:visibility="gone"/>

        <ProgressBar
            android:id="@+id/currentProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0" 
            android:visibility="gone"/>

        <TextView
            android:id="@+id/queueProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Kolejka: 0 / 0"
            android:textSize="14sp" 
            android:visibility="gone"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="#33000000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. ODCINKI NA PENDRIVE"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="▶ odtwarza odcinek. Zaznacz obejrzane odcinki, a potem naciśnij Usuń."
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/downloadedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/deleteButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="USUŃ ZAZNACZONE OBEJRZANE"
            android:textSize="17sp" />

        <Button
            android:id="@+id/advancedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Ustawienia zaawansowane" />

        <LinearLayout
            android:id="@+id/advancedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/engineStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Silnik pobierania: inicjalizacja..."
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ręczny numer startowy listy odcinków"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/startEpisodeEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="np. 1805"
                    android:inputType="number" />

                <Button
                    android:id="@+id/showEpisodesButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Ustaw" />
            </LinearLayout>

            <TextView
                android:id="@+id/catalogStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Katalog TVP: nie skonfigurowano"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/seriesUrlEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Główny adres serialu TVP"
                android:inputType="textUri"
                android:maxLines="2" />

            <Button
                android:id="@+id/saveSeriesButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zapisz serial" />

            <Button
                android:id="@+id/refreshCatalogButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Odśwież katalog TVP" />

            <Button
                android:id="@+id/editLinksButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tryb ręczny — edytuj linki" />

            <TextView
                android:id="@+id/infoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingBottom="20dp"
                android:text="Wersja 0.5.0 • prosty tryb obsługi VOD USB"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
